# systemd unit — install to /etc/systemd/system/ethicraft.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ethicraft
#   sudo journalctl -u ethicraft -f

[Unit]
Description=EthiCraft Club website (ethicraft.in)
Documentation=https://ethicraft.in
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ethicraft
Group=ethicraft
WorkingDirectory=/srv/ethicraft
EnvironmentFile=/srv/ethicraft/.env
ExecStart=/usr/bin/node server/index.js

# Give in-flight uploads a chance to finish; index.js handles SIGTERM.
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=always
RestartSec=3

# Hardening — the app only ever needs to write to data/ and uploads/.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/ethicraft/data /srv/ethicraft/uploads
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ethicraft

[Install]
WantedBy=multi-user.target
