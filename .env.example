# ---------------------------------------------------------------------------
# Copy to `.env` and change EVERY value before deploying.
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Public origin, used for canonical URLs, the sitemap and Open Graph tags.
SITE_ORIGIN=https://ethicraft.in

# --- Database ---------------------------------------------------------------
# Supabase → Project Settings → Database → Connection string → "Transaction
# pooler" (port 6543). Use the pooler, not the direct connection.
# Local development: postgres://localhost:5432/ethicraft_dev
DATABASE_URL=postgres://localhost:5432/ethicraft_dev

# --- Admin portal -----------------------------------------------------------
# Path to the dashboard. Keep it unguessable; it is never linked publicly.
ADMIN_PATH=/pick-something-unguessable
ADMIN_USERNAME=changeme
ADMIN_PASSWORD=change-this-to-a-long-passphrase

# --- Session ----------------------------------------------------------------
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
